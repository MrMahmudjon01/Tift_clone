# .env sifatida nusxalang:  cp env.example .env   (.env git'ga kirmaydi)

# Lokal ishlash uchun 1, production'da 0
DEBUG=1
# Production'da majburiy: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# Telegram bot (BotFather'dan). Bo'sh bo'lsa sayt ishlaydi, faqat bot ishlamaydi.
BOT_TOKEN=
# Webhook himoyasi: setWebhook(..., secret_token=SHU_QIYMAT) bilan bir xil bo'lsin
TELEGRAM_WEBHOOK_SECRET=

# Frontend boshqa domenda bo'lsa (vergul bilan)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
